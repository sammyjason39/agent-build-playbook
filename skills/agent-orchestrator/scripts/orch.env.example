# Copy to <ORCH_ROOT>/orch.env and adjust. Every script sources it.
# Keep ORCH_ROOT outside /tmp: /tmp is wiped on reboot and you lose prompts and logs.

# The repository the agents work on (the main checkout — agents never touch it).
REPO=/home/me/Github/my-product
# Where per-agent git worktrees are created (one folder per agent).
WT_ROOT=/home/me/Github/my-product-wt
# Prompts, logs and isolated agent data live here.
ORCH_ROOT=/home/me/Github/my-product-wt/_orchestration

# Install command run once in each fresh worktree (empty = skip).
INSTALL_CMD="corepack pnpm@9.15.4 install --frozen-lockfile"

# opencode model (provider/model); empty = opencode default.
OPENCODE_MODEL=""
# Title prefix shown in opencode sessions.
RUN_LABEL="ORCH"

# Concurrency cap for this machine (see references/parallelism.md).
MAX_PARALLEL=1
