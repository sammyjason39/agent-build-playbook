# Copy to <ORCH_ROOT>/orch.env and adjust. Every script sources it.
# Keep ORCH_ROOT outside /tmp: /tmp is wiped on reboot and you lose prompts and logs.

# The repository the agents work on (the main checkout — agents never touch it).
REPO=/home/me/code/my-project
# Where per-agent git worktrees are created (one folder per agent).
WT_ROOT=/home/me/code/my-project-wt
# Prompts, logs and isolated agent data live here.
ORCH_ROOT=/home/me/code/my-project-wt/_orchestration

# Install command run once in each fresh worktree (empty = skip). Examples:
#   npm ci | pnpm install --frozen-lockfile | pip install -r requirements.txt | go mod download | bundle install
INSTALL_CMD=""

# Worker agent (the coordinator — Claude Code / your main AI — dispatches to it):
#   opencode | pi | agy (Antigravity CLI) | custom
EXECUTOR=opencode
# Worker model; empty = the executor's default. opencode uses provider/model.
EXEC_MODEL=""
# Worker reasoning effort. Workers get precise prompts, so low/medium is usually enough.
#   opencode --variant (provider-specific: minimal|low|medium|high|max)
#   pi --thinking (off|minimal|low|medium|high|xhigh|max)
#   agy --effort (low|medium|high|max)
EXEC_EFFORT=medium
# custom executor only: command run in the worktree with $PROMPT_FILE, $WT, $AGENT_DATA set.
# EXEC_CMD='my-agent --yes --prompt-file "$PROMPT_FILE"'
# EXEC_RESUME_CMD='my-agent --continue --yes "$PROMPT"'

# Session title prefix (opencode).
RUN_LABEL="ORCH"
# Concurrency cap for this machine (see references/parallelism.md).
MAX_PARALLEL=1
